<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      LaunchTheme: shown while the Flutter engine is starting.
      Parent is Theme.Black.NoTitleBar so the window is NOT white.
      The actual background is set by launch_background.xml (maroon + icon).
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Remove the default Flutter white window background -->
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <!--
      NormalTheme: applied once Flutter draws its first frame.
      White background matches the app's default scaffold color.
    -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>
</resources>

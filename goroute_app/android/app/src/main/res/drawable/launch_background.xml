<?xml version="1.0" encoding="utf-8"?>
<!--
  Native splash screen shown before Flutter engine starts.
  Background: GoRoute brand maroon (#8B0000)
  Center: app launcher icon
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Brand background color — no white flash -->
    <item>
        <color android:color="#8B0000"/>
    </item>

    <!-- App icon centered on the screen -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher"/>
    </item>

</layer-list>
